  <script is:inline src="/sf_amenities.js"></script>
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script is:inline>
    (function () {
      "use strict";

      const payload = window.SF_AMENITIES_DATA || { amenities: [], datasets: {}, intersections: [] };
      const allAmenities = payload.amenities || [];
      const datasetMeta = payload.datasets || {};
      const sfIntersections = payload.intersections || [];

      const NEED_META = {
        garbage_can: {
          mainText: "Toss something",
          subText: "Nearest trash can",
          genericName: "Public Trash Can",
          libraryResourceName: "Indoor Trash & Recycling Bin",
          emoji: "🗑️",
          useBenchImg: false,
        },
        bench: {
          mainText: "Sit down",
          subText: "Nearest bench or seat",
          genericName: "Public Bench / Seat",
          libraryResourceName: "Indoor Library Seating",
          emoji: "🪑",
          useBenchImg: true,
        },
        water_fountain: {
          mainText: "Hydrate",
          subText: "Nearest water fountain",
          genericName: "Drinking Water Fountain",
          libraryResourceName: "Indoor Water Fountain",
          emoji: "🚰",
          useBenchImg: false,
        },
        bathroom: {
          mainText: "Go potty",
          subText: "Nearest open bathroom",
          genericName: "Public Bathroom",
          libraryResourceName: "Indoor Public Restroom",
          emoji: "🚻",
          useBenchImg: false,
        },
      };

      const ONE_MILE_METERS = 1609.344;

      const state = {
        step: "need",
        need: null,
        userLat: null,
        userLon: null,
        userLocationLabel: "",
        currentMatch: null,
        originalResultCoords: null,
        nearbyWithinMile: [],
        skippedIds: new Set(),
        isSatellite: false,
        humanVerified: false,
      };

      function updateTopNeedCard() {
        const slot = document.getElementById("selectedNeedHeader");
        if (!slot) return;

        if (!state.need || state.step === "need") {
          slot.classList.add("hidden");
          return;
        }

        const meta = NEED_META[state.need];
        if (!meta) return;

        const iconEl = document.getElementById("topNeedIcon");
        const mainEl = document.getElementById("topNeedMain");
        const subEl = document.getElementById("topNeedSub");

        if (iconEl) {
          iconEl.innerHTML = meta.useBenchImg
            ? `<img src="/bench-icon-28943-512.png" alt="" class="need-bench-img" />`
            : meta.emoji;
        }
        if (mainEl) mainEl.textContent = meta.mainText;
        if (subEl) subEl.textContent = meta.subText;

        slot.classList.remove("hidden");
      }

      function showScreen(stepName) {
        state.step = stepName;
        document.querySelectorAll(".screen").forEach((el) => el.classList.remove("active"));
        const target = document.getElementById(`screen-${stepName}`);
        if (target) target.classList.add("active");

        updateTopNeedCard();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function getSfNow() {
        const now = new Date();
        const fmt = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/Los_Angeles",
          weekday: "short",
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });
        const parts = {};
        for (const p of fmt.formatToParts(now)) {
          parts[p.type] = p.value;
        }
        const dayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        const dayIndex = dayMap[parts.weekday] ?? now.getDay();
        let hour = parseInt(parts.hour || "0", 10);
        if (hour === 24) hour = 0;
        const minute = parseInt(parts.minute || "0", 10);
        return {
          dayIndex,
          weekdayShort: parts.weekday || "Today",
          minutesOfDay: hour * 60 + minute,
        };
      }

      function parseHhmm(hhmm) {
        if (!hhmm) return null;
        const [hStr, mStr] = hhmm.split(":");
        const h = parseInt(hStr, 10);
        const m = parseInt(mStr || "0", 10);
        if (isNaN(h)) return null;
        return h * 60 + (isNaN(m) ? 0 : m);
      }

      function formatTime12h(totalMin) {
        if (totalMin <= 0 || totalMin >= 1440) return "midnight";
        const h = Math.floor(totalMin / 60) % 24;
        const m = totalMin % 60;
        const ampm = h < 12 ? "am" : "pm";
        const h12 = h % 12 === 0 ? 12 : h % 12;
        return m === 0 ? `${h12}${ampm}` : `${h12}:${String(m).padStart(2, "0")}${ampm}`;
      }

      function formatDurationRemaining(minsLeft) {
        if (minsLeft < 60) {
          return `in ${minsLeft} minute${minsLeft === 1 ? "" : "s"}`;
        }
        const hrs = Math.floor(minsLeft / 60);
        const mins = minsLeft % 60;
        if (mins === 0) {
          return `in ${hrs} hour${hrs === 1 ? "" : "s"}`;
        }
        return `in ${hrs} hr ${mins} min`;
      }

      function evaluateAmenityAccess(item, sfNow) {
        if (item.outOfService) {
          return { isOpen: false };
        }

        if (item.isLibrary && item.librarySchedule) {
          const todayRange = item.librarySchedule[String(sfNow.dayIndex)];
          if (!todayRange || todayRange.length < 2) {
            return { isOpen: false };
          }
          const openMin = parseHhmm(todayRange[0]);
          const closeMin = parseHhmm(todayRange[1]);
          const cur = sfNow.minutesOfDay;
          if (openMin !== null && closeMin !== null && cur >= openMin && cur < closeMin) {
            const minsLeft = closeMin - cur;
            return {
              isOpen: true,
              is24h: false,
              minsLeft,
              closingText: `🕒 Closes at ${formatTime12h(closeMin)} (${formatDurationRemaining(minsLeft)})`,
              bannerClass: minsLeft <= 45 ? "closes-soon" : "closes-later",
            };
          }
          return { isOpen: false };
        }

        if (item.days === "Special Events") {
          return { isOpen: false };
        }

        if (item.days === "Weekdays" && (sfNow.dayIndex === 0 || sfNow.dayIndex === 6)) {
          return { isOpen: false };
        }

        const openMin = parseHhmm(item.hoursOpen);
        const closeMin = parseHhmm(item.hoursClose);
        if (openMin !== null && closeMin !== null) {
          if (openMin === 0 && closeMin >= 1440) {
            return {
              isOpen: true,
              is24h: true,
              minsLeft: null,
              closingText: "",
              bannerClass: "open-24",
            };
          }

          const cur = sfNow.minutesOfDay;
          const isOvernight = openMin > closeMin;
          const isOpen = isOvernight
            ? cur >= openMin || cur < closeMin
            : cur >= openMin && cur < closeMin;

          if (!isOpen) {
            return { isOpen: false };
          }

          const minsLeft = isOvernight
            ? cur >= openMin
              ? 1440 - cur + closeMin
              : closeMin - cur
            : closeMin - cur;

          return {
            isOpen: true,
            is24h: false,
            minsLeft,
            closingText: `🕒 Closes at ${formatTime12h(closeMin)} (${formatDurationRemaining(minsLeft)})`,
            bannerClass: minsLeft <= 45 ? "closes-soon" : "closes-later",
          };
        }

        return {
          isOpen: true,
          is24h: true,
          minsLeft: null,
          closingText: "",
          bannerClass: "open-24",
        };
      }

      function haversineMeters(lat1, lon1, lat2, lon2) {
        const R = 6371000;
        const toRad = (d) => (d * Math.PI) / 180;
        const dLat = toRad(lat2 - lat1);
        const dLon = toRad(lon2 - lon1);
        const a =
          Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return 2 * R * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      function formatDistancePill(meters) {
        const feet = Math.round(meters * 3.28084);
        const miles = meters / 1609.344;
        const walkMins = Math.max(1, Math.round(meters / 78));
        const distStr = feet < 1000 ? `${feet} ft` : `${miles.toFixed(2)} mi`;
        return `🚶 ~${walkMins} min walk (${distStr})`;
      }

      function findClosestOpenAmenity() {
        const sfNow = getSfNow();
        let best = null;

        for (const item of allAmenities) {
          if (!item.categories.includes(state.need)) continue;
          if (state.skippedIds.has(item.id)) continue;

          const access = evaluateAmenityAccess(item, sfNow);
          if (!access.isOpen) continue;

          const distMeters = haversineMeters(state.userLat, state.userLon, item.lat, item.lon);
          if (!best || distMeters < best.distMeters) {
            best = { item, access, distMeters };
          }
        }
        return best;
      }

      function computeNearbyWithinOneMile(anchorLat, anchorLon) {
        const sfNow = getSfNow();
        const list = [];

        for (const item of allAmenities) {
          if (!item.categories.includes(state.need)) continue;
          if (state.skippedIds.has(item.id)) continue;

          const distFromOriginal = haversineMeters(anchorLat, anchorLon, item.lat, item.lon);
          if (distFromOriginal > ONE_MILE_METERS) continue;

          const access = evaluateAmenityAccess(item, sfNow);
          if (!access.isOpen) continue;

          const distFromUser = haversineMeters(state.userLat, state.userLon, item.lat, item.lon);
          list.push({
            item,
            access,
            distMeters: distFromUser,
            distFromOriginal,
          });
        }

        list.sort((a, b) => a.distFromOriginal - b.distFromOriginal);
        return list;
      }

      function describeResourceAndContainer(item, needKey) {
        const meta = NEED_META[needKey] || NEED_META.bathroom;

        if (item.isLibrary) {
          return {
            resourceName: meta.libraryResourceName,
            containerText: `Inside: ${item.name}`,
            sourceTooltip: `Maintained by: ${item.agency} (ID: ${item.uid || item.id})`,
          };
        }

        if (item.park) {
          return {
            resourceName: item.name,
            containerText: `Inside: ${item.park}`,
            sourceTooltip: `Maintained by: ${item.agency} (${item.uid || item.id})`,
          };
        }

        if (item.sourceCode === "dpw") {
          return {
            resourceName: "Public Sidewalk Trash Can",
            containerText: "",
            sourceTooltip: `Maintained by: ${item.agency} (${item.uid || "City Street Can"})`,
          };
        }

        return {
          resourceName: item.name || meta.genericName,
          containerText: "",
          sourceTooltip: `Maintained by: ${item.agency} (${item.uid || item.id})`,
        };
      }

      let smallMap = null;
      let streetTiles = null;
      let satTiles = null;
      let nearbyLayerGroup = null;
      let mapLayerGroup = null;

      function ensureSmallMap() {
        if (smallMap) return;

        smallMap = L.map("smallMap", {
          zoomControl: true,
          attributionControl: true,
        });

        streetTiles = L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
        });

        let switchedFallback = false;
        streetTiles.on("tileerror", function () {
          if (!switchedFallback) {
            switchedFallback = true;
            streetTiles.setUrl(
              "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
            );
          }
        });

        satTiles = L.tileLayer(
          "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
          {
            maxZoom: 19,
            attribution: "Tiles &copy; Esri",
          }
        );

        if (state.isSatellite) {
          satTiles.addTo(smallMap);
        } else {
          streetTiles.addTo(smallMap);
        }

        nearbyLayerGroup = L.layerGroup().addTo(smallMap);
        mapLayerGroup = L.layerGroup().addTo(smallMap);

        smallMap.on("moveend zoomend", () => {
          if (state.step === "result" && state.currentMatch) {
            renderNearbyPinsInView();
          }
        });
      }

      function toggleSatelliteView() {
        state.isSatellite = !state.isSatellite;
        const btn = document.getElementById("satToggleBtn");
        if (btn) {
          btn.textContent = state.isSatellite ? "🗺️ Street Map" : "🛰️ Satellite";
        }
        if (!smallMap) return;
        if (state.isSatellite) {
          if (smallMap.hasLayer(streetTiles)) smallMap.removeLayer(streetTiles);
          satTiles.addTo(smallMap);
        } else {
          if (smallMap.hasLayer(satTiles)) smallMap.removeLayer(satTiles);
          streetTiles.addTo(smallMap);
        }
      }

      function buildAmenityPopupHtml(item, info) {
        return `
          <div style="font-size:0.82rem;line-height:1.35;">
            <strong>${escapeHtml(info.resourceName)}</strong><br/>
            ${escapeHtml(item.address || item.neighborhood)}<br/>
            <span style="color:#475569;font-size:0.75rem;">
              ${escapeHtml(info.sourceTooltip)}<br/>
              DataSF Dataset: <code>${escapeHtml(item.datasetId)}</code>
            </span>
          </div>
        `;
      }

      function renderNearbyPinsInView() {
        if (!smallMap || !nearbyLayerGroup || !state.currentMatch) return;
        nearbyLayerGroup.clearLayers();

        const meta = NEED_META[state.need] || NEED_META.bathroom;
        const activeId = state.currentMatch.item.id;
        const bounds = smallMap.getBounds().pad(0.15);

        const innerIconHtml = meta.useBenchImg
          ? `<img src="/bench-icon-28943-512.png" alt="" />`
          : `<span>${meta.emoji}</span>`;

        let renderedCount = 0;
        const maxPinsInView = 80;

        for (const entry of state.nearbyWithinMile) {
          if (entry.item.id === activeId) continue;
          if (!bounds.contains([entry.item.lat, entry.item.lon])) continue;

          const nearbyIcon = L.divIcon({
            className: "",
            html: `<div class="nearby-amenity-pin" title="Tap to select">${innerIconHtml}</div>`,
            iconSize: [28, 28],
            iconAnchor: [14, 14],
          });

          const marker = L.marker([entry.item.lat, entry.item.lon], {
            icon: nearbyIcon,
            zIndexOffset: 400,
          }).addTo(nearbyLayerGroup);

          marker.on("click", () => {
            selectMatchOnResultScreen(entry, false, true);
          });

          renderedCount++;
          if (renderedCount >= maxPinsInView) break;
        }
      }

      function renderPrimaryPinsOnMap(startLat, startLon, item, needKey, info, fitMapBounds, openDestPopup) {
        const meta = NEED_META[needKey] || NEED_META.bathroom;
        ensureSmallMap();
        mapLayerGroup.clearLayers();

        const startIcon = L.divIcon({
          className: "",
          html: `
            <div class="you-are-here-pin">
              <div class="you-are-here-bubble">You are here</div>
              <div class="you-are-here-dot"></div>
            </div>
          `,
          iconSize: [90, 38],
          iconAnchor: [45, 34],
        });

        const startMarker = L.marker([startLat, startLon], {
          icon: startIcon,
          zIndexOffset: 900,
        }).addTo(mapLayerGroup);
        startMarker.bindPopup(`<strong>You are here</strong><br/>${escapeHtml(state.userLocationLabel)}`);

        const innerIconHtml = meta.useBenchImg
          ? `<img src="/bench-icon-28943-512.png" alt="Bench" />`
          : `<span>${meta.emoji}</span>`;

        const destIcon = L.divIcon({
          className: "",
          html: `<div class="dest-amenity-pin" title="Tap for source details">${innerIconHtml}</div>`,
          iconSize: [42, 42],
          iconAnchor: [21, 21],
        });

        const destMarker = L.marker([item.lat, item.lon], {
          icon: destIcon,
          zIndexOffset: 1000,
        }).addTo(mapLayerGroup);

        destMarker.bindPopup(buildAmenityPopupHtml(item, info));

        L.polyline(
          [
            [startLat, startLon],
            [item.lat, item.lon],
          ],
          {
            color: "#0284c7",
            weight: 4,
            dashArray: "7, 8",
            opacity: 0.85,
          }
        ).addTo(mapLayerGroup);

        setTimeout(() => {
          smallMap.invalidateSize();
          if (fitMapBounds) {
            const bounds = L.latLngBounds([
              [startLat, startLon],
              [item.lat, item.lon],
            ]);
            smallMap.fitBounds(bounds, { padding: [44, 44], maxZoom: 18 });
          }
          renderNearbyPinsInView();
          if (openDestPopup) {
            destMarker.openPopup();
          }
        }, 60);
      }

      function selectMatchOnResultScreen(match, fitMapBounds = true, openDestPopup = false) {
        state.currentMatch = match;
        const { item, access, distMeters } = match;
        const info = describeResourceAndContainer(item, state.need);

        document.getElementById("resDistancePill").textContent = formatDistancePill(distMeters);
        document.getElementById("resName").textContent = info.resourceName;

        const containerBox = document.getElementById("resContainerBox");
        if (containerBox) {
          if (info.containerText) {
            containerBox.textContent = info.containerText;
            containerBox.classList.remove("hidden");
          } else {
            containerBox.classList.add("hidden");
          }
        }

        const addrParts = [];
        if (item.address) addrParts.push(item.address);
        if (item.neighborhood && (!item.address || !item.address.includes(item.neighborhood))) {
          addrParts.push(item.neighborhood);
        }
        document.getElementById("resAddress").textContent = `📍 ${addrParts.join(" · ") || "San Francisco, CA"}`;

        const closingBanner = document.getElementById("resClosingBanner");
        if (closingBanner) {
          if (access.closingText) {
            closingBanner.className = `res-closing-banner ${access.bannerClass}`;
            closingBanner.textContent = access.closingText;
            closingBanner.classList.remove("hidden");
          } else {
            closingBanner.classList.add("hidden");
          }
        }

        const dirBtn = document.getElementById("openDirectionsBtn");
        if (dirBtn) {
          dirBtn.href = `https://www.google.com/maps/dir/?api=1&origin=${state.userLat},${state.userLon}&destination=${item.lat},${item.lon}&travelmode=walking`;
        }

        showScreen("result");
        renderPrimaryPinsOnMap(state.userLat, state.userLon, item, state.need, info, fitMapBounds, openDestPopup);
      }

      function computeAndShowResult() {
        const match = findClosestOpenAmenity();
        if (!match) {
          alert("No currently open matching amenities were found in San Francisco right now.");
          return;
        }

        state.originalResultCoords = { lat: match.item.lat, lon: match.item.lon };
        state.nearbyWithinMile = computeNearbyWithinOneMile(match.item.lat, match.item.lon);

        selectMatchOnResultScreen(match, true, false);
      }

      function openMissingScreen() {
        if (!state.currentMatch) return;
        const { item } = state.currentMatch;
        const ds = datasetMeta[item.datasetId] || {
          id: item.datasetId,
          title: item.datasetName || "DataSF Dataset",
          portalUrl: `https://data.sf.gov/d/${item.datasetId}`,
        };

        document.getElementById("nextNearestDesc").textContent = `Searches from ${item.address || item.name}.`;
        document.getElementById("reportDatasetSummary").textContent = `Opens a pre-filled email to DataSF Support with this location and asset ID (${item.uid || item.id}).`;

        const reportText = [
          `Hello DataSF Team,`,
          ``,
          `I visited this location and the listed public amenity was not there:`,
          ``,
          `- Dataset: ${ds.title} (https://data.sf.gov/d/${item.datasetId})`,
          `- Amenity: ${item.name}`,
          `- Asset ID: ${item.uid || item.id}${item.recologyId ? ` (Recology ID: ${item.recologyId})` : ""}`,
          `- Address: ${item.address || item.park || "San Francisco"} (${item.lat}, ${item.lon})`,
        ].join("\n");

        const mailtoUrl = `mailto:support@datasf.org?subject=${encodeURIComponent(
          `Missing Amenity in DataSF [${item.datasetId}]: ${item.address || item.name} (${item.uid || item.id})`
        )}&body=${encodeURIComponent(reportText)}`;

        const emailBtn = document.getElementById("emailDataSfDirectBtn");
        if (emailBtn) {
          emailBtn.href = mailtoUrl;
        }

        showScreen("missing");
      }

      function handleFindNextNearest() {
        if (state.currentMatch && state.currentMatch.item) {
          const missingItem = state.currentMatch.item;
          state.skippedIds.add(missingItem.id);
          state.userLat = missingItem.lat;
          state.userLon = missingItem.lon;
          state.userLocationLabel = `Near ${missingItem.address || missingItem.name}`;
        }
        computeAndShowResult();
      }

      const STOP_WORDS = new Set(["and", "&", "/", "@", "at", "in", "sf", "san", "francisco", "ca", "the", "corner", "of"]);
      const ABBREV_MAP = {
        st: "street",
        str: "street",
        ave: "avenue",
        av: "avenue",
        blvd: "boulevard",
        dr: "drive",
        rd: "road",
        ct: "court",
        pl: "place",
        ter: "terrace",
        ln: "lane",
        hwy: "highway",
      };

      function tokenizeQuery(raw) {
        return raw
          .toLowerCase()
          .replace(/[&/@,]+/g, " ")
          .split(/\s+/)
          .filter((t) => t && !STOP_WORDS.has(t))
          .map((t) => {
            const clean = t.replace(/^0+(\d+)/, "$1");
            return ABBREV_MAP[clean] || clean;
          });
      }

      function matchLocalIntersections(rawQuery, limit = 5) {
        const tokens = tokenizeQuery(rawQuery);
        if (tokens.length === 0) return [];

        const scored = [];
        for (const entry of sfIntersections) {
          const hay = `${entry.label} ${entry.neighborhood || ""}`.toLowerCase();
          const hayWords = hay.split(/[\s/]+/);

          let allMatch = true;
          let score = 0;

          for (const tok of tokens) {
            const numOrd = /^\d+$/.test(tok) ? `${tok}` : null;
            const wordMatched = hayWords.some((hw) => {
              if (hw === tok) {
                score += 10;
                return true;
              }
              if (hw.startsWith(tok)) {
                score += 6;
                return true;
              }
              if (numOrd && hw.replace(/(st|nd|rd|th)$/, "") === numOrd) {
                score += 8;
                return true;
              }
              return false;
            });
            if (!wordMatched) {
              allMatch = false;
              break;
            }
          }

          if (allMatch) {
            scored.push({ entry, score });
          }
        }

        scored.sort((a, b) => b.score - a.score || a.entry.label.length - b.entry.label.length);
        return scored.slice(0, limit).map((s) => s.entry);
      }

      function parseIntersectionStreets(rawQuery) {
        const m = rawQuery.trim().match(/^(.+?)\s+(?:and|&|\/|@|at)\s+(.+?)$/i);
        if (!m) return null;
        const cleanStreet = (s) =>
          s
            .trim()
            .replace(/\b(st|ave|blvd|dr|rd|ct|pl|way|ter|street|avenue|boulevard)\b\.?$/i, "")
            .trim();
        const s1 = cleanStreet(m[1]);
        const s2 = cleanStreet(m[2]);
        if (!s1 || !s2) return null;
        return [s1, s2];
      }

      async function queryOsmOverpassIntersection(streetA, streetB) {
        const esc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        const bbox = "37.70,-122.52,37.82,-122.35";
        const query = `[out:json][timeout:4];
          way["highway"]["name"~"^${esc(streetA)}",i](${bbox})->.w1;
          way["highway"]["name"~"^${esc(streetB)}",i](${bbox})->.w2;
          node(w.w1)(w.w2)->.int;
          (.int; .w1; .w2;);
          out body;`;

        try {
          const res = await fetch("https://overpass-api.de/api/interpreter", {
            method: "POST",
            body: "data=" + encodeURIComponent(query),
          });
          if (!res.ok) return [];
          const data = await res.json();
          const elements = data.elements || [];
          const nodes = elements.filter((e) => e.type === "node");
          const ways = elements.filter((e) => e.type === "way" && e.tags && e.tags.name);
          if (nodes.length === 0) return [];

          const results = [];
          const seenLabels = new Set();
          for (const n of nodes) {
            const matchingWays = ways.filter((w) => Array.isArray(w.nodes) && w.nodes.includes(n.id));
            const names = [...new Set(matchingWays.map((w) => w.tags.name))];
            const label = names.length >= 2 ? `${names[0]} and ${names[1]}` : `${streetA} and ${streetB}`;
            if (!seenLabels.has(label.toLowerCase())) {
              seenLabels.add(label.toLowerCase());
              results.push({
                label,
                neighborhood: "OpenStreetMap Intersection",
                lat: n.lat,
                lon: n.lon,
              });
            }
          }
          return results;
        } catch (_e) {
          return [];
        }
      }

      async function queryArcGisCandidates(rawQuery) {
        try {
          const url = `https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?SingleLine=${encodeURIComponent(
            rawQuery + ", San Francisco, CA"
          )}&location=-122.43,37.77&distance=15000&outFields=Match_addr,Addr_type&maxLocations=4&f=json`;
          const res = await fetch(url);
          if (!res.ok) return [];
          const data = await res.json();
          const cands = data.candidates || [];
          return cands
            .filter((c) => c.location && c.location.y >= 37.7 && c.location.y <= 37.83)
            .map((c) => {
              const cleanLabel = (c.address || "")
                .replace(/,\s*San Francisco.*$/i, "")
                .replace(/\s*&\s*/, " and ")
                .replace(/\bAve\b/g, "Avenue")
                .replace(/\bSt\b/g, "Street")
                .replace(/\bBlvd\b/g, "Boulevard");
              return {
                label: cleanLabel || rawQuery,
                neighborhood: "San Francisco",
                lat: c.location.y,
                lon: c.location.x,
              };
            });
        } catch (_e) {
          return [];
        }
      }

      let currentSuggestions = [];
      let suggestDebounceTimer = null;

      function renderSuggestionsDropdown(items) {
        currentSuggestions = items;
        const listEl = document.getElementById("addressSuggestionsList");
        if (!listEl) return;

        if (!items || items.length === 0) {
          listEl.classList.add("hidden");
          listEl.innerHTML = "";
          return;
        }

        listEl.innerHTML = items
          .map(
            (item, idx) => `
          <li class="suggestion-item" role="option" data-sug-idx="${idx}">
            <span>📍 ${escapeHtml(item.label)}</span>
            <span class="suggestion-sub">${escapeHtml(item.neighborhood || "SF")}</span>
          </li>
        `
          )
          .join("");
        listEl.classList.remove("hidden");

        listEl.querySelectorAll(".suggestion-item").forEach((li) => {
          li.addEventListener("click", () => {
            const idx = parseInt(li.getAttribute("data-sug-idx"), 10);
            const chosen = currentSuggestions[idx];
            if (chosen) {
              selectSuggestion(chosen);
            }
          });
        });
      }

      function selectSuggestion(chosen) {
        const input = document.getElementById("manualAddressInput");
        if (input) input.value = chosen.label;
        renderSuggestionsDropdown([]);
        state.userLat = chosen.lat;
        state.userLon = chosen.lon;
        state.userLocationLabel = chosen.label;
        computeAndShowResult();
      }

      function handleAddressInputTyping(rawVal) {
        const q = rawVal.trim();
        if (q.length < 2) {
          renderSuggestionsDropdown([]);
          return;
        }

        const localHits = matchLocalIntersections(q, 5);
        renderSuggestionsDropdown(localHits);

        if (suggestDebounceTimer) clearTimeout(suggestDebounceTimer);
        suggestDebounceTimer = setTimeout(async () => {
          const streets = parseIntersectionStreets(q);
          let remoteHits = [];
          if (streets) {
            remoteHits = await queryOsmOverpassIntersection(streets[0], streets[1]);
          }
          if (remoteHits.length === 0) {
            remoteHits = await queryArcGisCandidates(q);
          }

          const merged = [...localHits];
          const seen = new Set(localHits.map((h) => h.label.toLowerCase()));
          for (const rh of remoteHits) {
            if (!seen.has(rh.label.toLowerCase())) {
              seen.add(rh.label.toLowerCase());
              merged.push(rh);
            }
          }
          if (document.getElementById("manualAddressInput")?.value.trim() === q) {
            renderSuggestionsDropdown(merged.slice(0, 5));
          }
        }, 220);
      }

      async function resolveManualAddress(rawInput) {
        const query = rawInput.trim();
        if (!query) return;

        renderSuggestionsDropdown([]);

        const localHits = matchLocalIntersections(query, 1);
        if (localHits.length > 0) {
          selectSuggestion(localHits[0]);
          return;
        }

        const submitBtn = document.getElementById("manualAddressSubmitBtn");
        if (submitBtn) submitBtn.textContent = "Locating…";

        const streets = parseIntersectionStreets(query);
        if (streets) {
          const osmInt = await queryOsmOverpassIntersection(streets[0], streets[1]);
          if (osmInt.length > 0) {
            if (submitBtn) submitBtn.textContent = "Find Closest →";
            selectSuggestion(osmInt[0]);
            return;
          }
        }

        const arcHits = await queryArcGisCandidates(query);
        if (arcHits.length > 0) {
          if (submitBtn) submitBtn.textContent = "Find Closest →";
          selectSuggestion(arcHits[0]);
          return;
        }

        try {
          const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
            query + ", San Francisco, CA"
          )}&limit=1&viewbox=-122.53,37.84,-122.35,37.68&bounded=1`;
          const res = await fetch(url, { headers: { Accept: "application/json" } });
          if (res.ok) {
            const data = await res.json();
            if (Array.isArray(data) && data.length > 0) {
              const hit = data[0];
              if (submitBtn) submitBtn.textContent = "Find Closest →";
              selectSuggestion({
                label: hit.display_name.split(",").slice(0, 2).join(", "),
                lat: parseFloat(hit.lat),
                lon: parseFloat(hit.lon),
              });
              return;
            }
          }
        } catch (_e) {}

        if (submitBtn) submitBtn.textContent = "Find Closest →";
        alert("Could not find that address or intersection in San Francisco.");
      }

      function escapeHtml(str) {
        return String(str ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function init() {
        document.getElementById("changeNeedBtn")?.addEventListener("click", () => {
          state.need = null;
          state.skippedIds.clear();
          showScreen("need");
        });

        document.querySelectorAll(".need-card[data-need]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const needKey = btn.getAttribute("data-need");
            state.need = needKey;
            state.skippedIds.clear();
            showScreen("location");
          });
        });

        document.getElementById("shareGpsBtn")?.addEventListener("click", () => {
          const gpsBtn = document.getElementById("shareGpsBtn");
          const statusMsg = document.getElementById("gpsStatusMsg");
          if (!navigator.geolocation) {
            if (statusMsg) {
              statusMsg.textContent = "Location sharing is not supported by your browser. Please enter an address below.";
              statusMsg.classList.remove("hidden");
            }
            return;
          }

          if (gpsBtn) {
            gpsBtn.innerHTML = `<span class="cta-icon">📡</span><span>Getting your location…</span>`;
          }
          if (statusMsg) statusMsg.classList.add("hidden");

          navigator.geolocation.getCurrentPosition(
            (pos) => {
              if (gpsBtn) {
                gpsBtn.innerHTML = `<span class="cta-icon">📍</span><span>Use my current location</span>`;
              }
              const { latitude, longitude } = pos.coords;
              state.userLat = latitude;
              state.userLon = longitude;
              state.userLocationLabel = "Your current location";
              computeAndShowResult();
            },
            (_err) => {
              if (gpsBtn) {
                gpsBtn.innerHTML = `<span class="cta-icon">📍</span><span>Use my current location</span>`;
              }
              if (statusMsg) {
                statusMsg.textContent = "Could not access GPS. Please enter an address below.";
                statusMsg.classList.remove("hidden");
              }
            },
            { enableHighAccuracy: true, timeout: 8000 }
          );
        });

        const addrInput = document.getElementById("manualAddressInput");
        if (addrInput) {
          addrInput.addEventListener("input", () => {
            handleAddressInputTyping(addrInput.value);
          });
        }

        document.getElementById("manualAddressForm")?.addEventListener("submit", (e) => {
          e.preventDefault();
          if (addrInput && addrInput.value.trim()) {
            resolveManualAddress(addrInput.value);
          }
        });

        document.getElementById("changeLocBtn")?.addEventListener("click", () => {
          showScreen("location");
        });

        document.getElementById("satToggleBtn")?.addEventListener("click", () => {
          toggleSatelliteView();
        });

        document.getElementById("notHereBtn")?.addEventListener("click", () => {
          openMissingScreen();
        });

        document.getElementById("findNextNearestBtn")?.addEventListener("click", () => {
          handleFindNextNearest();
        });

        window.addEventListener(
          "pointerdown",
          () => {
            state.humanVerified = true;
          },
          { once: true, passive: true }
        );
        window.addEventListener(
          "keydown",
          () => {
            state.humanVerified = true;
          },
          { once: true, passive: true }
        );

        const fbBackdrop = document.getElementById("feedbackModalBackdrop");
        document.getElementById("openFeedbackBtn")?.addEventListener("click", () => {
          state.humanVerified = true;
          fbBackdrop?.classList.remove("hidden");
          document.getElementById("feedbackMessageInput")?.focus();
        });
        document.getElementById("closeFeedbackBtn")?.addEventListener("click", () => {
          fbBackdrop?.classList.add("hidden");
        });
        fbBackdrop?.addEventListener("click", (e) => {
          if (e.target === fbBackdrop) fbBackdrop.classList.add("hidden");
        });

        document.getElementById("feedbackForm")?.addEventListener("submit", (e) => {
          e.preventDefault();
          const hpVal = document.getElementById("hpWebsiteField")?.value;
          if (hpVal || !state.humanVerified) {
            fbBackdrop?.classList.add("hidden");
            return;
          }

          const msg = (document.getElementById("feedbackMessageInput")?.value || "").trim();
          if (!msg) return;

          const encoded = [45, 38, 60, 46, 103, 43, 59, 32, 46, 33, 61, 9, 46, 36, 40, 32, 37, 103, 42, 38, 36];
          const recipient = encoded.map((b) => String.fromCharCode(b ^ 73)).join("");

          const contextLines = [
            msg,
            "",
            "---",
            `App Context: Need=${state.need || "none"}, Step=${state.step}, Search=${state.userLocationLabel || "none"}`,
          ].join("\n");

          const mailto = `mailto:${recipient}?subject=${encodeURIComponent(
            "SF Public Amenities App Feedback"
          )}&body=${encodeURIComponent(contextLines)}`;

          window.location.href = mailto;
          document.getElementById("feedbackMessageInput").value = "";
          fbBackdrop?.classList.add("hidden");
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</Layout>
