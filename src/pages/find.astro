---
import Layout from '../layouts/Project.astro';
---

<Layout
  title="SF Public Amenity Finder"
  description="Find the closest open bathroom, water fountain, trash can, or bench in San Francisco"
  pubDate={new Date()}
>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <div class="wizard-shell">
    <!-- Persistent Selected Need Card at the top of steps 2, 3, 4 (tap to change) -->
    <div class="selected-need-Slot hidden" id="selectedNeedHeader">
      <button type="button" class="need-card selected-top-card" id="changeNeedBtn" title="Tap to change what you need">
        <span class="need-icon" id="topNeedIcon" aria-hidden="true">🗑️</span>
        <span class="need-text">
          <span class="need-main" id="topNeedMain">Toss something</span>
          <span class="need-sub" id="topNeedSub">Nearest trash can</span>
        </span>
        <span class="need-change-label">Change</span>
      </button>
    </div>

    <!-- STEP 1: "I need to..." -->
    <section class="screen active" id="screen-need" aria-labelledby="needHeading">
      <div class="screen-inner">
        <h1 class="hero-title" id="needHeading">I need to…</h1>

        <div class="need-grid">
          <button type="button" class="need-card" data-need="garbage_can">
            <span class="need-icon" aria-hidden="true">🗑️</span>
            <span class="need-text">
              <span class="need-main">Toss something</span>
              <span class="need-sub">Nearest trash can</span>
            </span>
            <span class="need-arrow">→</span>
          </button>

          <button type="button" class="need-card" data-need="bench">
            <span class="need-icon" aria-hidden="true">
              <img src="/bench-icon-28943-512.png" alt="" class="need-bench-img" />
            </span>
            <span class="need-text">
              <span class="need-main">Sit down</span>
              <span class="need-sub">Nearest bench or seat</span>
            </span>
            <span class="need-arrow">→</span>
          </button>

          <button type="button" class="need-card" data-need="water_fountain">
            <span class="need-icon" aria-hidden="true">🚰</span>
            <span class="need-text">
              <span class="need-main">Hydrate</span>
              <span class="need-sub">Nearest water fountain</span>
            </span>
            <span class="need-arrow">→</span>
          </button>

          <button type="button" class="need-card" data-need="bathroom">
            <span class="need-icon" aria-hidden="true">🚻</span>
            <span class="need-text">
              <span class="need-main">Go potty</span>
              <span class="need-sub">Nearest open bathroom</span>
            </span>
            <span class="need-arrow">→</span>
          </button>
        </div>
      </div>
    </section>

    <!-- STEP 2: Location ("Where are you?") -->
    <section class="screen" id="screen-location" aria-labelledby="locHeading">
      <div class="screen-inner">
        <h1 class="hero-title" id="locHeading">Where are you?</h1>

        <button type="button" class="primary-cta-btn" id="shareGpsBtn">
          <span class="cta-icon">📍</span>
          <span>Use my current location</span>
        </button>
        <p class="gps-status-msg hidden" id="gpsStatusMsg"></p>

        <div class="divider"><span>or</span></div>

        <form id="manualAddressForm" class="address-form" autocomplete="off">
          <div class="autocomplete-wrap">
            <input
              type="text"
              id="manualAddressInput"
              class="address-input"
              placeholder="Enter address or intersection (e.g. 18th and Irving)…"
              autocomplete="off"
              aria-autocomplete="list"
              aria-controls="addressSuggestionsList"
            />
            <ul class="suggestions-list hidden" id="addressSuggestionsList" role="listbox"></ul>
          </div>
          <button type="submit" class="secondary-cta-btn" id="manualAddressSubmitBtn">
            Find Closest →
          </button>
        </form>
      </div>
    </section>

    <!-- STEP 3: Result ("Here is the closest open one") -->
    <section class="screen" id="screen-result" aria-labelledby="resName">
      <div class="screen-inner">
        <div class="distance-pill-row">
          <span class="distance-pill" id="resDistancePill">Walking time</span>
          <button type="button" class="change-loc-link" id="changeLocBtn">Change location</button>
        </div>

        <div class="result-card">
          <h1 class="res-title" id="resName">Amenity Name</h1>
          <div class="res-container-box hidden" id="resContainerBox"></div>
          <div class="res-address" id="resAddress">Address</div>
          <div class="res-closing-banner" id="resClosingBanner"></div>
        </div>

        <!-- Small Map showing Start Pin ("You are here") + Amenity Icon + Satellite Toggle -->
        <div class="small-map-card">
          <div class="map-wrap">
            <div id="smallMap" class="small-map" role="application" aria-label="Map showing your location and the amenity"></div>
            <button type="button" class="sat-toggle-btn" id="satToggleBtn">
              🛰️ Satellite
            </button>
          </div>
          <div class="map-legend">
            <span><span class="legend-dot start-dot"></span> You are here</span>
            <span>Tap any pin for details or to select</span>
          </div>
        </div>

        <!-- Primary Action: Directions (opens Maps app) -->
        <a
          href="#"
          target="_blank"
          rel="noopener"
          class="primary-cta-btn directions-btn"
          id="openDirectionsBtn"
        >
          <span class="cta-icon">🧭</span>
          <span>Directions</span>
        </a>

        <!-- Secondary Action: It's not here! -->
        <button type="button" class="not-here-btn" id="notHereBtn">
          🚫 It's not here!
        </button>
      </div>
    </section>

    <!-- STEP 4: "It's not here!" -> (1) Next Nearest, (2) Report the Issue -->
    <section class="screen" id="screen-missing" aria-labelledby="missingHeading">
      <div class="screen-inner">
        <h1 class="hero-title" id="missingHeading">It's not there?</h1>

        <!-- Option 1: Find the next nearest option based on new location -->
        <div class="action-choice-card highlight-choice">
          <div class="choice-header">
            <h2 class="choice-title">Find the next nearest option</h2>
            <p class="choice-desc" id="nextNearestDesc">
              Searches from where you are now.
            </p>
          </div>
          <button type="button" class="primary-cta-btn" id="findNextNearestBtn">
            <span>👉 Next nearest open option</span>
          </button>
        </div>

        <!-- Option 2: Report the issue -->
        <div class="action-choice-card">
          <div class="choice-header">
            <h2 class="choice-title">Report the issue</h2>
            <p class="choice-desc" id="reportDatasetSummary"></p>
          </div>
          <a href="#" class="secondary-cta-btn report-email-btn" id="emailDataSfDirectBtn">
            ✉️ Email DataSF (Pre-filled)
          </a>
        </div>
      </div>
    </section>

    <!-- Subtle App Feedback Footer -->
    <footer class="app-footer">
      <button type="button" class="feedback-trigger-btn" id="openFeedbackBtn">
        💬 Send app feedback
      </button>
    </footer>
  </div>

  <hr />

  <!-- Project Backstory & Data Sources -->
  <div class="project-context">
    <section class="context-section">
      <h2>Why I Built This</h2>
      <p>
        When you're out walking or biking in San Francisco and have an immediate, everyday need—a trash can to toss something, a bench to sit down, a water fountain to hydrate, or an actually <em>open</em> bathroom—finding the nearest option shouldn't require digging through complex GIS portals or walking up to a locked door.
      </p>
      <p>
        City data for these basic public micro-amenities exists on San Francisco's open data portal, but it's split across multiple departments (for example, sidewalk trash cans maintained by Public Works vs. park trash cans maintained by Recreation &amp; Parks). Raw datasets also miss how people actually use public space: a <strong>San Francisco Public Library branch</strong> isn't just a book catalog—during open hours, it provides a bathroom, a water fountain, a trash bin, and a place to sit.
      </p>
      <p>
        I designed this tool around four simple questions: <em>What do you need? Where are you? Where is the closest open one (and when does it close)?</em> And if you get there and the amenity is missing: <em>Take me to the next closest one right away, and let me report the bad data point with one tap.</em>
      </p>
      <p class="standalone-note">
        📱 <strong>Standalone Mobile App URL:</strong> <a href="https://sf-public-amenities.netlify.app" target="_blank" rel="noopener noreferrer">sf-public-amenities.netlify.app ↗</a>
      </p>
    </section>

    <section class="context-section">
      <h2>DataSF Open Data Sources Used</h2>
      <div class="dataset-grid">
        <div class="dataset-card">
          <div class="dataset-head">
            <h3>San Francisco Public Bathrooms &amp; Water Fountains</h3>
            <a href="https://data.sf.gov/d/wfq4-upmv" target="_blank" rel="noopener noreferrer" class="dataset-badge">wfq4-upmv ↗</a>
          </div>
          <p>
            Combines public restrooms, staffed <em>Pit Stop</em> toilets, JCDecaux automatic toilets, and drinking water fountains / bottle fillers managed across SF Recreation &amp; Parks, Public Works, SFPUC (<em>DrinkTap</em>), the Port of San Francisco, and SF Public Library.
          </p>
        </div>

        <div class="dataset-card">
          <div class="dataset-head">
            <h3>Trash Can Locations (SF Public Works)</h3>
            <a href="https://data.sf.gov/d/5buk-jp7b" target="_blank" rel="noopener noreferrer" class="dataset-badge">5buk-jp7b ↗</a>
          </div>
          <p>
            Tracks ~1,970 active public sidewalk trash receptacles maintained by San Francisco Public Works and Recology, along with 1,400+ street intersection records used to power the app's live intersection autofiller.
          </p>
        </div>

        <div class="dataset-card">
          <div class="dataset-head">
            <h3>Assets Maintained by the Recreation &amp; Parks Dept</h3>
            <a href="https://data.sf.gov/d/e3jj-mbb3" target="_blank" rel="noopener noreferrer" class="dataset-badge">e3jj-mbb3 ↗</a>
          </div>
          <p>
            Supplies ~3,830 park benches, memorial benches, and picnic tables—plus ~1,270 park trash cans—spatially cross-referenced with park names, addresses, and operating hours.
          </p>
        </div>

        <div class="dataset-card">
          <div class="dataset-head">
            <h3>Public Library Facilities &amp; Branch Schedules</h3>
            <a href="https://data.sf.gov/d/nc68-ngbr" target="_blank" rel="noopener noreferrer" class="dataset-badge">nc68-ngbr ↗</a>
          </div>
          <p>
            Models all 28 San Francisco Public Library branches as composite multi-amenity hubs (supplying indoor restrooms, drinking water, trash bins, and seating) evaluated in real time against each branch's daily schedule in Pacific Time.
          </p>
        </div>
      </div>
    </section>

    <!-- Changelog Drawer -->
    <section class="changelog-drawer">
      <details>
        <summary>View Recent Updates &amp; Technical Decisions</summary>
        <div class="changelog-content">
          <h4>[2026-11-05] — Step-by-Step Flow, Live Intersection Autofiller &amp; Interactive Map</h4>
          <p><strong>What Changed:</strong></p>
          <ul>
            <li>Redesigned into a focused 4-step mobile flow (Need → Location → Closest Open Result + Map → Missing/Fallback).</li>
            <li>Built a unified DataSF pipeline (7,560 SF amenities across <code>wfq4-upmv</code>, <code>5buk-jp7b</code>, <code>e3jj-mbb3</code>, and all 28 SFPL branches with live closing countdowns).</li>
            <li>Added a live intersection autofiller combining 1,424 canonical DataSF street corners with OpenStreetMap Overpass node intersection queries (so typing <code>18th and irving</code> resolves directly to <code>18th Avenue and Irving Street</code> rather than a street midpoint).</li>
            <li>Added an interactive result map with Satellite view toggle, clickable nearby open amenities within a 1-mile radius, and a one-tap pre-filled DataSF error report.</li>
          </ul>
          <h4>[2026-10-23] — SFPL Integration, Schedule Filtering &amp; Deduplication</h4>
          <p><strong>What Changed:</strong></p>
          <ul>
            <li>Integrated SFPL branches across Restrooms, Water Fountains, Waste Disposal, and Seating.</li>
            <li>Implemented client-side schedule validation pinned to Pacific Time (<code>America/Los_Angeles</code>).</li>
          </ul>
        </div>
      </details>
    </section>
  </div>

  <!-- Anti-Spam Feedback Modal -->
  <div class="modal-backdrop hidden" id="feedbackModalBackdrop" role="dialog" aria-modal="true" aria-labelledby="feedbackModalTitle">
    <div class="modal-card">
      <div class="modal-top">
        <h2 class="choice-title" id="feedbackModalTitle">Send Feedback</h2>
        <button type="button" class="modal-close-x" id="closeFeedbackBtn" aria-label="Close">✕</button>
      </div>
      <form id="feedbackForm" class="feedback-form">
        <div class="hp-wrap" aria-hidden="true">
          <label for="hpWebsiteField">Leave this field blank</label>
          <input type="text" id="hpWebsiteField" name="website_url" tabindex="-1" autocomplete="off" />
        </div>
        <textarea
          id="feedbackMessageInput"
          class="feedback-textarea"
          placeholder="What worked well, or what could be improved?"
          required
        ></textarea>
        <button type="submit" class="primary-cta-btn">
          Send Feedback →
        </button>
      </form>
    </div>
  </div>

  <style is:global>
    :root {
      --bg-page: #fafafa;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --primary-soft: #e0f2fe;
      --green: #15803d;
      --green-bg: #dcfce7;
      --amber: #b45309;
      --amber-bg: #fef3c7;
      --red: #b91c1c;
      --red-bg: #fef2f2;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow: 0 4px 18px rgba(15, 23, 42, 0.07);
    }

    .wizard-shell {
      max-width: 480px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
    }

    .hidden {
      display: none !important;
    }

    .selected-need-Slot {
      padding: 4px 0 12px;
    }

    .need-card.selected-top-card {
      padding: 12px 16px;
      border-color: var(--primary);
      background: var(--bg-card);
    }

    .need-card.selected-top-card .need-icon {
      width: 44px;
      height: 44px;
      font-size: 1.5rem;
      border-radius: 12px;
    }

    .need-card.selected-top-card .need-main {
      font-size: 1.05rem;
    }

    .need-card.selected-top-card .need-sub {
      font-size: 0.78rem;
    }

    .need-change-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-soft);
      padding: 5px 10px;
      border-radius: 999px;
    }

    .screen {
      display: none;
      padding: 8px 0 24px;
    }

    .screen.active {
      display: block;
      animation: fadeIn 0.15s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .screen-inner {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .hero-title {
      font-size: 1.85rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--text-main);
      line-height: 1.15;
      margin: 0;
    }

    .need-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 4px;
    }

    .need-card {
      display: flex;
      align-items: center;
      gap: 16px;
      width: 100%;
      padding: 18px 20px;
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      cursor: pointer;
      text-align: left;
      transition: transform 0.12s ease, border-color 0.12s ease;
    }

    .need-card:hover,
    .need-card:focus-visible {
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    .need-card:active {
      transform: scale(0.99);
    }

    .need-icon {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.85rem;
      flex-shrink: 0;
    }

    .need-bench-img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    .need-text {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .need-main {
      font-size: 1.22rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .need-sub {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .need-arrow {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--primary);
    }

    .primary-cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 20px;
      border-radius: var(--radius-md);
      border: none;
      background: var(--primary);
      color: #ffffff;
      font-size: 1.05rem;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.28);
      transition: background 0.15s;
    }

    .primary-cta-btn:hover {
      background: var(--primary-hover);
    }

    .cta-icon {
      font-size: 1.2rem;
    }

    .gps-status-msg {
      font-size: 0.85rem;
      color: var(--amber);
      background: var(--amber-bg);
      padding: 10px 12px;
      border-radius: 10px;
      font-weight: 600;
    }

    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 600;
      margin: 2px 0;
    }

    .divider::before,
    .divider::after {
      content: "";
      flex: 1;
      border-bottom: 1px solid var(--border);
    }

    .divider span {
      padding: 0 10px;
    }

    .address-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .autocomplete-wrap {
      position: relative;
      width: 100%;
    }

    .suggestions-list {
      list-style: none;
      margin: 6px 0 0;
      padding: 0;
      background: var(--bg-card);
      border: 2px solid var(--primary);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow);
      overflow: hidden;
      max-height: 240px;
      overflow-y: auto;
    }

    .suggestion-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .suggestion-item:last-child {
      border-bottom: none;
    }

    .suggestion-item:hover,
    .suggestion-item.active {
      background: var(--primary-soft);
      color: var(--primary-hover);
    }

    .suggestion-sub {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .address-input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      font-size: 1rem;
      background: var(--bg-card);
      color: var(--text-main);
      outline: none;
      box-sizing: border-box;
    }

    .address-input:focus {
      border-color: var(--primary);
    }

    .secondary-cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 14px 18px;
      border-radius: var(--radius-md);
      border: 2px solid var(--text-main);
      background: var(--text-main);
      color: #ffffff;
      font-size: 0.98rem;
      font-weight: 800;
      text-decoration: none;
      text-align: center;
      cursor: pointer;
      box-sizing: border-box;
    }

    .distance-pill-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .distance-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--green-bg);
      color: var(--green);
      font-size: 0.9rem;
      font-weight: 800;
      padding: 6px 13px;
      border-radius: 999px;
    }

    .change-loc-link {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: underline;
      cursor: pointer;
    }

    .result-card {
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .res-title {
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--text-main);
      line-height: 1.2;
      margin: 0;
    }

    .res-container-box {
      background: #f1f5f9;
      border-left: 4px solid var(--primary);
      padding: 8px 12px;
      border-radius: 6px 10px 10px 6px;
      font-size: 0.88rem;
      color: var(--text-main);
      font-weight: 700;
    }

    .res-address {
      font-size: 0.98rem;
      color: var(--text-secondary);
      font-weight: 600;
    }

    .res-closing-banner {
      margin-top: 2px;
      padding: 9px 12px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 700;
    }

    .res-closing-banner.open-24 {
      background: var(--green-bg);
      color: var(--green);
    }

    .res-closing-banner.closes-later {
      background: var(--primary-soft);
      color: var(--primary-hover);
    }

    .res-closing-banner.closes-soon {
      background: var(--amber-bg);
      color: var(--amber);
    }

    .small-map-card {
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .map-wrap {
      position: relative;
    }

    .small-map {
      width: 100%;
      height: 225px;
    }

    .sat-toggle-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 500;
      background: rgba(15, 23, 42, 0.85);
      color: #ffffff;
      border: 1.5px solid rgba(255, 255, 255, 0.7);
      padding: 6px 11px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    .sat-toggle-btn:hover {
      background: #0f172a;
    }

    .map-legend {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 14px;
